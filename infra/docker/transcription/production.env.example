# Copiez ces variables dans l'onglet Environment du projet Dokploy consacré à
# la transcription de production. Ne commitez jamais le fichier `.env` généré.

COMPOSE_PROJECT_NAME=mevo2glpi-prod-transcription
APP_RELEASE=CHANGE_ME
APP_COMMIT_SHA=CHANGE_ME
TRANSCRIPTION_NETWORK_NAME=mevo2glpi-prod-transcription-network
TRANSCRIPTION_NETWORK_ALIAS=mevo2glpi-prod-transcription

# Cette clé doit être identique à OPENAI_COMPATIBLE_TRANSCRIPTION_API_KEY dans
# le projet applicatif de production.
TRANSCRIPTION_API_KEY=CHANGE_ME

# Le modèle Q8 et le runtime sont inclus et vérifiés pendant le build. Pour
# utiliser un autre artefact approuvé, fournissez ensemble son URL immuable et
# son SHA-256 ; ne pointez jamais vers une branche ou un alias mutable.
PARAKEET_ULTRA_MODEL_URL=https://huggingface.co/handy-computer/parakeet-ultra-gguf/resolve/a1539be1b849ea7463b88343e5277b373d0c4ea9/parakeet-ultra-Q8_0.gguf
PARAKEET_ULTRA_MODEL_SHA256=007a59761e9258779f189df396b50d12b83bb5b79e66df4b955c230d2f2a0a59
TRANSCRIPTION_MODEL_PATH=/models/parakeet-ultra-Q8_0.gguf
TRANSCRIPTION_MODEL_NAME=parakeet-ultra

# Ressources et paramètres du runtime CPU qualifiés en staging.
TRANSCRIPTION_CPUS=2.0
TRANSCRIPTION_CPU_THREADS=2
TRANSCRIPTION_MEMORY_LIMIT=4g
TRANSCRIPTION_LOG_LEVEL=info

# Bornes de validation et de normalisation audio qualifiées en staging.
TRANSCRIPTION_MAX_UPLOAD_BYTES=26214400
TRANSCRIPTION_MAX_AUDIO_SECONDS=600
TRANSCRIPTION_FFMPEG_TIMEOUT_SECONDS=60
