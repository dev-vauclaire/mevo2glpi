# Copiez ces variables dans l'onglet Environment du projet Dokploy consacré à
# la transcription. Ne commitez jamais le fichier `.env` généré.

# Le même manifeste est utilisé en staging puis en production. Utilisez des
# noms de projet, de réseau, d'alias et des secrets distincts par environnement.
COMPOSE_PROJECT_NAME=gta-staging-transcription
TRANSCRIPTION_NETWORK_NAME=gta-staging-transcription-network
PARAKEET_NETWORK_ALIAS=gta-staging-parakeet

# Cette clé doit être identique dans le projet applicatif du même environnement.
PARAKEET_API_KEY=CHANGE_ME

# Limites initiales à ajuster après observation de l'inférence CPU en staging.
PARAKEET_CPUS=2.0
PARAKEET_MEMORY_LIMIT=3g
