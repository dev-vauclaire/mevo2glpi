# Copiez ces variables dans l'onglet Environment du projet Dokploy simulateurs.
# Ne commitez jamais le fichier `.env` généré : toutes les valeurs CHANGE_ME
# doivent être remplacées par des secrets exclusivement réservés au staging.

# -----------------------------------------------------------------------------
# Docker Compose, réseaux et volumes neufs
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=gta-staging-simulators
SIMULATORS_NETWORK_NAME=gta-staging-simulators-network

# -----------------------------------------------------------------------------
# Microsoft Graph et boîte Exchange synthétiques
# -----------------------------------------------------------------------------
MICROSOFT_GRAPH_SIMULATOR_MAILBOX_ID=00000000-0000-4000-8000-000000000003
MICROSOFT_GRAPH_SIMULATOR_ADMIN_TOKEN=CHANGE_ME
# Répertoire de la VM contenant uniquement des WAV/OGG de recette non sensibles.
# Il est monté en lecture seule dans /fixtures/audio et doit exister avant le
# déploiement ; Docker ne le crée pas automatiquement.
MICROSOFT_GRAPH_SIMULATOR_AUDIO_FIXTURES_HOST_PATH=/srv/gta-staging/audio-fixtures

# -----------------------------------------------------------------------------
# Transcribe AI synthétique
# -----------------------------------------------------------------------------
TRANSCRIBE_AI_SIMULATOR_API_KEY=CHANGE_ME

# -----------------------------------------------------------------------------
# Simulation GLPI 11.0.7 optionnelle, désactivée par défaut
# -----------------------------------------------------------------------------
# Décommenter avec la recette GLPI de docker-compose.simulators.yml.
# DOKPLOY_NETWORK_NAME=dokploy-network
# GLPI_DATA_VOLUME_NAME=gta-staging-simulators-glpi-data
# GLPI_DATABASE_VOLUME_NAME=gta-staging-simulators-glpi-database-data
# GLPI_DB_NAME=glpi_staging
# GLPI_DB_USER=glpi_staging
# GLPI_DB_PASSWORD=CHANGE_ME
# GLPI_DB_ROOT_PASSWORD=CHANGE_ME

# Les trois noms doivent commencer par `glpi-staging-`. Le bootstrap idempotent
# sécurise l'administrateur, désactive les comptes de démonstration, puis crée
# ou réconcilie l'utilisateur de service et le client OAuth Password/scope api.
# GLPI_ADMIN_USERNAME=glpi-staging-admin
# GLPI_ADMIN_PASSWORD=CHANGE_ME
# GLPI_USERNAME=glpi-staging-worker
# GLPI_PASSWORD=CHANGE_ME
# GLPI_OAUTH_CLIENT_NAME=glpi-staging-automation
# GLPI_CLIENT_ID=glpi-staging-client-identifier-0001
# GLPI_CLIENT_SECRET=CHANGE_ME
