# Copiez ces variables dans l'onglet Environment du projet Dokploy staging.
# Ne commitez jamais le fichier `.env` généré : toutes les valeurs CHANGE_ME
# doivent être remplacées par des secrets propres au staging.

# -----------------------------------------------------------------------------
# Docker Compose et Dokploy
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=gta-staging
GTA_DOKPLOY_ENV_FILE=./infra/docker/.env
DOKPLOY_NETWORK_NAME=dokploy-network
DATABASE_NETWORK_NAME=gta-staging-database-network
AUDIO_VOLUME_NAME=gta-staging-audio-data
GLPI_DATA_VOLUME_NAME=gta-staging-glpi-data
GLPI_DATABASE_VOLUME_NAME=gta-staging-glpi-database-data
CA_BUNDLE_HOST_PATH=/etc/ssl/certs/ca-certificates.crt

# -----------------------------------------------------------------------------
# PostgreSQL externe dédié au staging
# -----------------------------------------------------------------------------
# Utilisez une base et un utilisateur différents de la production. Le nom
# `postgres-staging` doit être résolu sur DATABASE_NETWORK_NAME.
DATABASE_URL=postgresql+psycopg://gta_staging:CHANGE_ME@postgres-staging:5432/glpi_ticketing_staging
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_READY_TIMEOUT_SECONDS=60
DATABASE_READY_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Application web staging
# -----------------------------------------------------------------------------
# Configurez le domaine correspondant sur le service `web` dans Dokploy.
PUBLIC_BASE_URL=https://gta-staging.example.internal
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
DASHBOARD_WORKER_STALE_AFTER_SECONDS=45
DASHBOARD_PENDING_ALERT_AFTER_SECONDS=900
DASHBOARD_RETRY_OVERDUE_GRACE_SECONDS=60
DASHBOARD_RETENTION_DEADLINE_GRACE_SECONDS=120

# -----------------------------------------------------------------------------
# Simulateur Graph et Transcribe AI
# -----------------------------------------------------------------------------
# Ces secrets sont exclusivement synthétiques et ne doivent jamais être
# réutilisés en production. Le simulateur n'est pas exposé par Traefik.
PROVIDER_SIMULATOR_ADMIN_TOKEN=CHANGE_ME_WITH_A_RANDOM_STAGING_ADMIN_TOKEN
PROVIDER_SIMULATOR_TRANSCRIPTION_API_KEY=CHANGE_ME_WITH_A_RANDOM_STAGING_TRANSCRIPTION_KEY

# UUID fictif partagé par le publisher et le simulateur Graph.
PUBLISHER_MAILBOX_ID=00000000-0000-4000-8000-000000000003

# -----------------------------------------------------------------------------
# Worker publisher en mode Graph synthétique
# -----------------------------------------------------------------------------
PUBLISHER_LOG_LEVEL=INFO
PUBLISHER_GRAPH_PAGE_SIZE=50
PUBLISHER_MAX_ATTACHMENT_BYTES=26214400
PUBLISHER_HTTP_TIMEOUT_SECONDS=10
PUBLISHER_POLL_INTERVAL_SECONDS=30
PUBLISHER_HEARTBEAT_INTERVAL_SECONDS=10
PUBLISHER_RETRY_INITIAL_SECONDS=5
PUBLISHER_RETRY_MAX_SECONDS=300
PUBLISHER_SYSTEM_PROBE_INTERVAL_SECONDS=60
WORKER_HEALTHCHECK_STALE_AFTER_SECONDS=45

# -----------------------------------------------------------------------------
# GLPI 11.0.7 staging et MySQL privé
# -----------------------------------------------------------------------------
# Configurez un second domaine Dokploy sur le service `glpi`. Restreignez-le
# au réseau interne ou au VPN : cette version est alignée avec la production,
# mais ne doit pas être publiée directement sur Internet.
GLPI_DB_NAME=glpi_staging
GLPI_DB_USER=glpi_staging
GLPI_DB_PASSWORD=CHANGE_ME_WITH_A_RANDOM_GLPI_DATABASE_PASSWORD
GLPI_DB_ROOT_PASSWORD=CHANGE_ME_WITH_A_RANDOM_GLPI_ROOT_PASSWORD

# Les trois noms doivent commencer par `glpi-staging-`. Le bootstrap idempotent
# sécurise l'administrateur, désactive les comptes de démonstration, puis crée
# ou réconcilie l'utilisateur de service et le client OAuth Password/scope api.
GLPI_ADMIN_USERNAME=glpi-staging-admin
GLPI_ADMIN_PASSWORD=CHANGE_ME_WITH_A_RANDOM_GLPI_ADMIN_PASSWORD
GLPI_USERNAME=glpi-staging-worker
GLPI_PASSWORD=CHANGE_ME_WITH_A_RANDOM_GLPI_USER_PASSWORD
GLPI_OAUTH_CLIENT_NAME=glpi-staging-automation
GLPI_CLIENT_ID=glpi-staging-client-identifier-0001
GLPI_CLIENT_SECRET=CHANGE_ME_WITH_A_RANDOM_GLPI_CLIENT_SECRET
GLPI_HTTP_TIMEOUT_SECONDS=10

# -----------------------------------------------------------------------------
# Worker d'automatisation
# -----------------------------------------------------------------------------
WORKER_LOG_LEVEL=INFO
WORKER_IDLE_INTERVAL_SECONDS=1
WORKER_RETRY_INITIAL_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
WORKER_SYSTEM_PROBE_INTERVAL_SECONDS=60
COMPLETED_RETENTION_DAYS=90
FAILED_RETENTION_DAYS=30
BLOCKED_RETENTION_DAYS=90
RETENTION_CHECK_INTERVAL_HOURS=6
TRANSCRIPTION_HTTP_TIMEOUT_SECONDS=10
TRANSCRIPTION_POLL_INTERVAL_SECONDS=2
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=900
GLPI_TICKET_TITLE=Demande issue d'un audio de recette staging
GLPI_TICKET_TYPE=2
GLPI_TICKET_URGENCY=3
GLPI_TICKET_IMPACT=3

# -----------------------------------------------------------------------------
# Worker de rétention
# -----------------------------------------------------------------------------
RETENTION_POLL_INTERVAL_SECONDS=60
RETENTION_RETRY_INITIAL_SECONDS=5
RETENTION_RETRY_MAX_SECONDS=300
RETENTION_SYSTEM_PROBE_INTERVAL_SECONDS=60
