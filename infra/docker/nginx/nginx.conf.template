worker_processes auto;
pid /tmp/nginx.pid;

error_log /dev/stderr notice;

events {
    worker_connections 1024;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" request_id=$request_id';
    access_log /dev/stdout main;

    client_body_temp_path /tmp/client-body;
    proxy_temp_path /tmp/proxy;
    fastcgi_temp_path /tmp/fastcgi;
    uwsgi_temp_path /tmp/uwsgi;
    scgi_temp_path /tmp/scgi;
    sendfile on;
    keepalive_timeout 65;
    server_tokens off;

    resolver 127.0.0.11 valid=10s ipv6=off;

    upstream gta_web {
        zone gta_web 64k;
        server web:8000 resolve;
        keepalive 16;
    }

    server {
        listen 127.0.0.1:8081;
        access_log off;

        location = /healthz {
            proxy_pass http://gta_web/health;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
        }

        location / {
            return 404;
        }
    }

    server {
        listen 8080;
        server_name _;

        return 308 https://${NGINX_PUBLIC_HOST}${NGINX_EXTERNAL_HTTPS_SUFFIX}$request_uri;
    }

    server {
        listen 8443 ssl;
        server_name _;

        ssl_certificate /run/secrets/nginx_tls_certificate;
        ssl_certificate_key /run/secrets/nginx_tls_key;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:TLS:10m;
        ssl_session_timeout 1d;
        ssl_session_tickets off;

        auth_basic "GLPI Ticketing Automation MVP";
        auth_basic_user_file /run/secrets/nginx_htpasswd;

        client_max_body_size 27m;

        add_header X-Content-Type-Options nosniff always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;

        location / {
            proxy_pass http://gta_web;
            proxy_http_version 1.1;
            proxy_set_header Connection "";
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header X-Request-ID $request_id;
            proxy_set_header Authorization "";
            proxy_request_buffering off;
            proxy_buffering off;
            proxy_read_timeout 60s;
        }
    }
}
