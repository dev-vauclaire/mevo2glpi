# Copiez ce fichier dans l'onglet Environment de Dokploy.
# Ne commitez jamais le fichier .env réel : il contient des secrets.

# -----------------------------------------------------------------------------
# Docker Compose et Dokploy
# -----------------------------------------------------------------------------
# Nom du projet Compose. Il préfixe les conteneurs créés par Dokploy.
COMPOSE_PROJECT_NAME=mevo2glpi-prod

# Identité non sensible du déploiement. Remplacez les deux placeholders par le
# tag immuable et le SHA Git complet réellement sélectionnés dans Dokploy.
# Ces valeurs alimentent les labels OCI et l'endpoint `/api/version`.
APP_ENVIRONMENT=production
APP_RELEASE=CHANGE_ME
APP_COMMIT_SHA=CHANGE_ME

# Réseau proxy externe créé par Dokploy. Conservez `dokploy-network` lorsque le
# domaine est géré dans Dokploy : ce nom est aussi injecté dans le label Traefik.
DOKPLOY_NETWORK_NAME=dokploy-network

# Réseau privé partagé uniquement avec le PostgreSQL externe. Créez ce réseau
# avant le premier déploiement et attachez-y le service PostgreSQL.
DATABASE_NETWORK_NAME=mevo2glpi-prod-database-network

# Réseau privé partagé uniquement entre le worker d'automatisation et la stack
# de transcription locale. Il doit porter exactement le même nom dans les deux
# projets Dokploy, même si le provider historique reste sélectionné par défaut.
TRANSCRIPTION_NETWORK_NAME=mevo2glpi-prod-transcription-network

# Volume persistant partagé par le web et les trois workers. Utilisez un nom
# différent pour chaque environnement déployé sur le même hôte.
AUDIO_VOLUME_NAME=mevo2glpi-prod-audio-data

# Bundle de confiance présent sur l'hôte Dokploy et monté en lecture seule dans
# les cinq conteneurs. Pour une CA interne, fournissez un bundle combinant la
# CA interne et les autorités publiques nécessaires. Ne désactivez pas TLS.
CA_BUNDLE_HOST_PATH=/etc/ssl/certs/ca-certificates.crt

# Clé AES-256 dédiée à la protection temporaire du numéro d'origine. Le fichier
# contient exactement 32 octets aléatoires encodés en Base64 et reste hors Git.
# Montez le même fichier dans publisher et automation pendant toute la durée
# des jobs en cours.
ORIGINATING_PHONE_NUMBER_KEY_HOST_PATH=/etc/mevo2glpi/secrets/originating-phone-number.key

# -----------------------------------------------------------------------------
# PostgreSQL Database Dokploy — partagé par les cinq applications
# -----------------------------------------------------------------------------
# URL SQLAlchemy obligatoire. Le mot de passe doit être encodé dans l'URL.
# N'utilisez pas localhost : dans un conteneur, il désigne le conteneur lui-même.
# Sur le réseau Docker privé ci-dessus, PostgreSQL peut rester non exposé. Si la
# connexion quitte cet hôte, imposez `sslmode=verify-full` dans cette URL ; le
# bundle monté est disponible sous /etc/ssl/certs/mevo2glpi-ca-bundle.pem.
DATABASE_URL=postgresql+psycopg://mevo2glpi:CHANGE_ME@postgres:5432/mevo2glpi

# Délai de connexion utilisé par la migration et les workers.
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Application de migration one-shot
# -----------------------------------------------------------------------------
# Temps maximal pendant lequel la migration attend PostgreSQL au démarrage.
DATABASE_READY_TIMEOUT_SECONDS=60

# Intervalle entre deux tentatives de connexion pendant cette attente.
DATABASE_READY_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Application web
# -----------------------------------------------------------------------------
# AUDIO_ROOT, WEB_HOST, WEB_PORT et WEB_TRUST_PROXY_HEADERS sont des invariants
# du Compose : /data/audios, 0.0.0.0, 8000 et true. Les en-têtes transmis par
# Traefik sont nécessaires pour générer des URL HTTPS correctes.
# Le web n'a pas d'authentification applicative : protégez son domaine dans
# Dokploy/Traefik et limitez-le au réseau interne.
# URL publique configurée dans l'onglet Domains de Dokploy. Le worker l'utilise
# pour écrire le lien de téléchargement de l'audio dans le ticket GLPI.
PUBLIC_BASE_URL=https://tickets.example.internal

# Fréquence commune des heartbeats émis par les workers.
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# Seuils du tableau d'observabilité, tous exprimés en secondes.
DASHBOARD_WORKER_STALE_AFTER_SECONDS=45
DASHBOARD_PENDING_ALERT_AFTER_SECONDS=900
DASHBOARD_RETRY_OVERDUE_GRACE_SECONDS=60
DASHBOARD_RETENTION_DEADLINE_GRACE_SECONDS=120

# -----------------------------------------------------------------------------
# Worker d'automatisation
# -----------------------------------------------------------------------------
# Niveau des logs applicatifs : INFO en usage normal, DEBUG temporairement pour
# diagnostiquer une erreur réseau/TLS GLPI sans journaliser les secrets ni les
# corps HTTP. Revenir à INFO après l'investigation.
WORKER_LOG_LEVEL=INFO

# Attente lorsqu'aucun job n'est disponible.
WORKER_IDLE_INTERVAL_SECONDS=1

# Un healthcheck devient invalide au-delà de ce délai sans heartbeat.
WORKER_HEALTHCHECK_STALE_AFTER_SECONDS=45

# Backoff appliqué quand GLPI ou le provider de transcription est temporairement
# indisponible. La valeur 3 autorise trois reprogrammations après la tentative
# initiale. À épuisement, la transcription produit un ticket dégradé tandis
# qu'une indisponibilité GLPI bloque le job pour décision opérateur.
WORKER_RETRY_INITIAL_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
WORKER_MAX_CONSECUTIVE_RETRIES=3
WORKER_SYSTEM_PROBE_INTERVAL_SECONDS=60

# Délais de conservation utilisés lors de la création de la rétention.
COMPLETED_RETENTION_DAYS=90
FAILED_RETENTION_DAYS=10
BLOCKED_RETENTION_DAYS=90

# Fréquence de recontrôle d'un ticket GLPI encore ouvert, en heures.
RETENTION_CHECK_INTERVAL_HOURS=6

# -----------------------------------------------------------------------------
# Transcription — utilisée uniquement par le worker d'automatisation
# -----------------------------------------------------------------------------
# Parakeet via l'API synchrone OpenAI-compatible constitue le provider nominal.
# `legacy_polling` reste disponible comme choix explicite de repli lorsque le
# service historique et ses deux variables ci-dessous sont configurés.
TRANSCRIPTION_PROVIDER=openai_compatible

# Provider historique : base sans chemin createJob/result et secret associé.
LEGACY_TRANSCRIPTION_BASE_URL=https://transcribe-ai.example.internal
LEGACY_TRANSCRIPTION_API_KEY=CHANGE_ME

# Provider OpenAI-compatible nominal. La clé doit être identique à
# TRANSCRIPTION_API_KEY dans le projet Dokploy de transcription de production.
OPENAI_COMPATIBLE_TRANSCRIPTION_BASE_URL=http://mevo2glpi-prod-transcription:5092/v1
OPENAI_COMPATIBLE_TRANSCRIPTION_API_KEY=CHANGE_ME
OPENAI_COMPATIBLE_TRANSCRIPTION_MODEL=parakeet-ultra
OPENAI_COMPATIBLE_TRANSCRIPTION_LANGUAGE=fr

TRANSCRIPTION_HTTP_TIMEOUT_SECONDS=180
TRANSCRIPTION_POLL_INTERVAL_SECONDS=2
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=900

# -----------------------------------------------------------------------------
# Worker publisher — ingestion Microsoft 365 / Graph
# -----------------------------------------------------------------------------
# Identifiants de l'application Entra ID et de la boîte dédiée. Pour la boîte,
# utilisez l'Object ID Entra de l'utilisateur, pas son Exchange GUID.
PUBLISHER_ENTRA_TENANT_ID=00000000-0000-4000-8000-000000000001
PUBLISHER_ENTRA_CLIENT_ID=00000000-0000-4000-8000-000000000002
PUBLISHER_MAILBOX_ID=00000000-0000-4000-8000-000000000003

# Deux fichiers PEM distincts présents sur l'hôte Dokploy. La clé privée doit
# être lisible par l'UID/GID 10001 du conteneur. Le second fichier est le
# certificat public X.509 associé (`BEGIN CERTIFICATE`) et non une clé publique
# brute (`BEGIN PUBLIC KEY`). Ce certificat exact doit être enregistré dans
# Certificates & secrets de l'application Entra. Ne commitez aucun de ces fichiers.
PUBLISHER_ENTRA_PRIVATE_KEY_PEM_HOST_PATH=/etc/mevo2glpi/secrets/publisher-private-key.pem
PUBLISHER_ENTRA_CERTIFICATE_PEM_HOST_PATH=/etc/mevo2glpi/secrets/publisher-certificate.pem

# Laisser vide si la clé privée n'est pas chiffrée. Si elle l'est, Dokploy
# transmet la valeur exacte : les espaces en bordure font partie du secret.
PUBLISHER_ENTRA_PRIVATE_KEY_PASSPHRASE=

# DEBUG est réservé au diagnostic temporaire ; aucun identifiant de message,
# contenu de mail, pièce jointe ou jeton n'est alors journalisé.
PUBLISHER_LOG_LEVEL=INFO
PUBLISHER_GRAPH_PAGE_SIZE=50
PUBLISHER_MAX_ATTACHMENT_BYTES=26214400
PUBLISHER_HTTP_TIMEOUT_SECONDS=10
PUBLISHER_POLL_INTERVAL_SECONDS=30
PUBLISHER_HEARTBEAT_INTERVAL_SECONDS=10
PUBLISHER_RETRY_INITIAL_SECONDS=5
PUBLISHER_RETRY_MAX_SECONDS=300
# Intervalle de vérification d'une demande d'arrêt lorsque le worker est
# verrouillé après une erreur système terminale. Aucun appel Graph automatique
# n'est effectué dans cet état : corrigez la cause puis redémarrez le service.
PUBLISHER_SYSTEM_PROBE_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# GLPI — utilisé par les deux workers
# -----------------------------------------------------------------------------
# URL de base de GLPI, sans identifiants, query string ni fragment.
GLPI_BASE_URL=https://glpi.example.internal

# Utilisateur de service et client OAuth Password dédiés à l'application.
# Configurez le fuseau du compte GLPI, ou son fuseau global hérité, sur
# Europe/Paris afin que la date d'ouverture soit interprétée sans ambiguïté.
GLPI_USERNAME=CHANGE_ME
GLPI_PASSWORD=CHANGE_ME
GLPI_CLIENT_ID=CHANGE_ME
GLPI_CLIENT_SECRET=CHANGE_ME

GLPI_HTTP_TIMEOUT_SECONDS=10

# Valeurs fixes appliquées aux tickets créés par le worker d'automatisation.
GLPI_TICKET_TITLE=Demande issue d'un audio
# Type : 1=incident (défaut), 2=demande.
GLPI_TICKET_TYPE=1
# Identifiant local de la source `MEVO` dans le GLPI de production. Cet ID peut
# différer de celui du staging et doit être relevé dans l'instance cible.
GLPI_TICKET_REQUEST_SOURCE_ID=CHANGE_ME_WITH_THE_PRODUCTION_MEVO_REQUEST_SOURCE_ID
GLPI_TICKET_URGENCY=3
GLPI_TICKET_IMPACT=3

# -----------------------------------------------------------------------------
# Worker de rétention
# -----------------------------------------------------------------------------
# Fréquence de recherche d'une rétention éligible.
RETENTION_POLL_INTERVAL_SECONDS=60

# Backoff appliqué lorsque GLPI est temporairement indisponible.
RETENTION_RETRY_INITIAL_SECONDS=5
RETENTION_RETRY_MAX_SECONDS=300
RETENTION_SYSTEM_PROBE_INTERVAL_SECONDS=60
