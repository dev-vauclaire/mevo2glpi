# Copiez ces variables dans l'onglet Environment du projet Dokploy staging.
# Ne commitez jamais le fichier `.env` généré ni un certificat privé.

# -----------------------------------------------------------------------------
# Docker Compose, réseaux et volume audio
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=mevo2glpi-staging

# Identité non sensible du déploiement. Le SHA complet doit être actualisé avant
# chaque déploiement staging manuel et comparé au commit affiché par Dokploy.
APP_ENVIRONMENT=staging
APP_RELEASE=main
APP_COMMIT_SHA=CHANGE_ME

DOKPLOY_NETWORK_NAME=dokploy-network
DATABASE_NETWORK_NAME=mevo2glpi-staging-database-network
SIMULATORS_NETWORK_NAME=mevo2glpi-staging-simulators-network
TRANSCRIPTION_NETWORK_NAME=mevo2glpi-staging-transcription-network
AUDIO_VOLUME_NAME=mevo2glpi-staging-audio-data

# Bundle de confiance utilisé pour joindre le GLPI de test externe.
CA_BUNDLE_HOST_PATH=/etc/ssl/certs/ca-certificates.crt

# Clé synthétique propre au staging, partagée uniquement par publisher et
# automation. Le fichier contient 32 octets aléatoires encodés en Base64.
ORIGINATING_PHONE_NUMBER_KEY_HOST_PATH=/etc/mevo2glpi/secrets/staging-originating-phone-number.key

# -----------------------------------------------------------------------------
# PostgreSQL Database Dokploy dédié au staging
# -----------------------------------------------------------------------------
# `postgres-staging` est l'alias du service sur le réseau Docker partagé.
DATABASE_URL=postgresql+psycopg://mevo2glpi_staging:CHANGE_ME@postgres-staging:5432/mevo2glpi_staging?sslmode=disable
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_READY_TIMEOUT_SECONDS=60
DATABASE_READY_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Application web staging
# -----------------------------------------------------------------------------
# Tant qu'aucun domaine n'est attribué, la valeur doit rester une URL de
# staging non productive ; les liens audio des tickets ne seront pas utilisables.
PUBLIC_BASE_URL=https://mevo2glpi-staging.example.internal
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
DASHBOARD_WORKER_STALE_AFTER_SECONDS=45
DASHBOARD_PENDING_ALERT_AFTER_SECONDS=900
DASHBOARD_RETRY_OVERDUE_GRACE_SECONDS=60
DASHBOARD_RETENTION_DEADLINE_GRACE_SECONDS=120

# -----------------------------------------------------------------------------
# Simulateurs et moteur de transcription déployés séparément
# -----------------------------------------------------------------------------
# La première clé conserve le provider historique pour les tests contractuels
# et le retour arrière. La seconde protège l'API de transcription réellement
# sélectionné par ce staging. Les valeurs doivent être identiques à celles du
# projet Dokploy correspondant. L'UUID correspond à la boîte fictive Graph.
TRANSCRIBE_AI_SIMULATOR_API_KEY=CHANGE_ME_WITH_A_RANDOM_STAGING_TRANSCRIPTION_KEY
LEGACY_TRANSCRIPTION_BASE_URL=http://mevo2glpi-staging-transcribe-ai:8080
OPENAI_COMPATIBLE_TRANSCRIPTION_BASE_URL=http://mevo2glpi-staging-transcription:5092/v1
TRANSCRIPTION_API_KEY=CHANGE_ME_WITH_A_RANDOM_STAGING_TRANSCRIPTION_API_KEY
PUBLISHER_MAILBOX_ID=00000000-0000-4000-8000-000000000003

# -----------------------------------------------------------------------------
# Worker publisher en mode Graph synthétique
# -----------------------------------------------------------------------------
PUBLISHER_GRAPH_BASE_URL=http://mevo2glpi-staging-microsoft-graph:8080/v1.0
PUBLISHER_LOG_LEVEL=INFO
PUBLISHER_GRAPH_PAGE_SIZE=50
PUBLISHER_MAX_ATTACHMENT_BYTES=26214400
PUBLISHER_HTTP_TIMEOUT_SECONDS=10
PUBLISHER_POLL_INTERVAL_SECONDS=30
PUBLISHER_HEARTBEAT_INTERVAL_SECONDS=10
PUBLISHER_RETRY_INITIAL_SECONDS=5
PUBLISHER_RETRY_MAX_SECONDS=300
PUBLISHER_SYSTEM_PROBE_INTERVAL_SECONDS=60
WORKER_HEALTHCHECK_STALE_AFTER_SECONDS=45

# -----------------------------------------------------------------------------
# GLPI de test, externe ou déployé dans un projet Compose Dokploy dédié
# -----------------------------------------------------------------------------
GLPI_BASE_URL=https://glpi-test.example.internal
GLPI_USERNAME=CHANGE_ME_WITH_THE_STAGING_GLPI_USER
GLPI_PASSWORD=CHANGE_ME_WITH_THE_STAGING_GLPI_PASSWORD
GLPI_CLIENT_ID=CHANGE_ME_WITH_THE_STAGING_GLPI_CLIENT_ID
GLPI_CLIENT_SECRET=CHANGE_ME_WITH_THE_STAGING_GLPI_CLIENT_SECRET
GLPI_HTTP_TIMEOUT_SECONDS=10
# Le compte GLPI de test (ou son fuseau global hérité) doit utiliser
# Europe/Paris, comme le compte de production.

# -----------------------------------------------------------------------------
# Worker d'automatisation
# -----------------------------------------------------------------------------
TRANSCRIPTION_PROVIDER=openai_compatible
WORKER_LOG_LEVEL=INFO
WORKER_IDLE_INTERVAL_SECONDS=1
WORKER_RETRY_INITIAL_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
# Trois reprogrammations au maximum après la tentative initiale.
WORKER_MAX_CONSECUTIVE_RETRIES=3
WORKER_SYSTEM_PROBE_INTERVAL_SECONDS=60
COMPLETED_RETENTION_DAYS=90
FAILED_RETENTION_DAYS=30
BLOCKED_RETENTION_DAYS=90
RETENTION_CHECK_INTERVAL_HOURS=6
# L'inférence CPU est synchrone : ce délai est volontairement supérieur à
# celui du provider historique afin d'éviter un retry pendant une inférence.
TRANSCRIPTION_HTTP_TIMEOUT_SECONDS=120
TRANSCRIPTION_POLL_INTERVAL_SECONDS=2
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=900
GLPI_TICKET_TITLE=Demande issue d'un audio de recette staging
# Type : 1=incident (défaut), 2=demande.
GLPI_TICKET_TYPE=1
# Identifiant local de la source `MEVO` dans le GLPI de test. Ne recopiez pas
# automatiquement l'ID de production : chaque instance possède ses propres IDs.
GLPI_TICKET_REQUEST_SOURCE_ID=CHANGE_ME_WITH_THE_STAGING_MEVO_REQUEST_SOURCE_ID
GLPI_TICKET_URGENCY=3
GLPI_TICKET_IMPACT=3

# -----------------------------------------------------------------------------
# Worker de rétention
# -----------------------------------------------------------------------------
RETENTION_POLL_INTERVAL_SECONDS=60
RETENTION_RETRY_INITIAL_SECONDS=5
RETENTION_RETRY_MAX_SECONDS=300
RETENTION_SYSTEM_PROBE_INTERVAL_SECONDS=60

# Purge automatique des rejets sans job. Le scan utilise
# RETENTION_CHECK_INTERVAL_HOURS et traite au plus 100 lignes par transaction.
REJECTED_INGESTION_RETENTION_DAYS=90
