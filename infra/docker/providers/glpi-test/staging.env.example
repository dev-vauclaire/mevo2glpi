# Modèle réservé au GLPI synthétique de staging. Copiez ces variables dans
# l'onglet Environment du projet Docker Compose Dokploy. Remplacez chaque
# valeur CHANGE_ME par un secret distinct de toute autre infrastructure.

# -----------------------------------------------------------------------------
# Projet Dokploy, réseau Traefik et ressources persistantes
# -----------------------------------------------------------------------------
COMPOSE_PROJECT_NAME=mevo2glpi-staging-glpi
DOKPLOY_NETWORK_NAME=dokploy-network
GLPI_TEST_DATABASE_NETWORK_NAME=mevo2glpi-staging-glpi-database-network
GLPI_TEST_DATA_VOLUME_NAME=mevo2glpi-staging-glpi-data
GLPI_TEST_DATABASE_VOLUME_NAME=mevo2glpi-staging-glpi-database-data
GLPI_TEST_IMAGE_NAME=mevo2glpi-staging-glpi:11.0.7

# -----------------------------------------------------------------------------
# MySQL privé de l'instance GLPI
# -----------------------------------------------------------------------------
GLPI_TEST_DB_NAME=glpi
GLPI_TEST_DB_USER=glpi-test-db
GLPI_TEST_DB_PASSWORD=CHANGE_ME_WITH_A_RANDOM_STAGING_DATABASE_PASSWORD
GLPI_TEST_DB_ROOT_PASSWORD=CHANGE_ME_WITH_A_DISTINCT_RANDOM_ROOT_PASSWORD

# -----------------------------------------------------------------------------
# Utilisateur et client OAuth exclusivement réservés au staging
# Les deux noms doivent conserver le préfixe glpi-test- imposé par le bootstrap.
# -----------------------------------------------------------------------------
GLPI_TEST_USERNAME=glpi-test-staging-user
GLPI_TEST_PASSWORD=CHANGE_ME_WITH_A_RANDOM_STAGING_USER_PASSWORD
GLPI_TEST_OAUTH_CLIENT_NAME=glpi-test-staging-oauth
GLPI_TEST_CLIENT_ID=glpi-test-staging-client-id
GLPI_TEST_CLIENT_SECRET=CHANGE_ME_WITH_A_RANDOM_STAGING_OAUTH_CLIENT_SECRET
GLPI_TEST_REQUEST_SOURCE_NAME=MEVO
GLPI_TEST_TIMEZONE=Europe/Paris
