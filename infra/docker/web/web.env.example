# La limite du reverse proxy doit être cohérente avec cette valeur.
MAX_UPLOAD_BYTES=26214400
# Secret obligatoire. Utiliser le compte PostgreSQL dédié à l'application web.
DATABASE_URL=postgresql+psycopg://glpi_ticketing_web:change-me@postgres:5432/glpi_ticketing
# Compose surcharge cette valeur à true uniquement sur son réseau privé Nginx.
WEB_TRUST_PROXY_HEADERS=false
