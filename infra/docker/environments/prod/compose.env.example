COMPOSE_PROJECT_NAME=gta-prod

GTA_POSTGRES_DB=glpi_ticketing_automation
GTA_POSTGRES_USER=gta
GTA_POSTGRES_PASSWORD_FILE=/etc/glpi-ticketing-automation/prod/secrets/postgres.password
GTA_POSTGRES_SECRET_GID=20000

GTA_MIGRATIONS_ENV_FILE=/etc/glpi-ticketing-automation/prod/services/migrations.env
GTA_DATABASE_ENV_FILE=/etc/glpi-ticketing-automation/prod/services/database.env
GTA_WEB_ENV_FILE=/etc/glpi-ticketing-automation/prod/services/web.env
GTA_AUTOMATION_ENV_FILE=/etc/glpi-ticketing-automation/prod/services/worker-automation.env
GTA_RETENTION_ENV_FILE=/etc/glpi-ticketing-automation/prod/services/worker-retention.env

GTA_NGINX_BIND_IP=127.0.0.1
GTA_NGINX_HTTPS_PORT=443
GTA_NGINX_TLS_CERTIFICATE_FILE=/etc/glpi-ticketing-automation/prod/secrets/nginx.crt
GTA_NGINX_TLS_KEY_FILE=/etc/glpi-ticketing-automation/prod/secrets/nginx.key
GTA_NGINX_HTPASSWD_FILE=/etc/glpi-ticketing-automation/prod/secrets/nginx.htpasswd
GTA_NGINX_SECRET_GID=20001
