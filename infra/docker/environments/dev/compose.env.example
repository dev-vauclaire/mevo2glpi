COMPOSE_PROJECT_NAME=gta-dev

GTA_POSTGRES_DB=glpi_ticketing_automation
GTA_POSTGRES_USER=gta
GTA_POSTGRES_PASSWORD_FILE=./environments/dev/secrets/postgres.password
GTA_POSTGRES_SECRET_GID=20000

GTA_MIGRATIONS_IMAGE=gta/database-migrations:dev
GTA_WEB_IMAGE=gta/web:dev
GTA_AUTOMATION_IMAGE=gta/worker-automation:dev
GTA_RETENTION_IMAGE=gta/worker-retention:dev
GTA_NGINX_IMAGE=gta/nginx:dev
GTA_IMAGE_VERSION=dev
GTA_VCS_REF=unknown

GTA_MIGRATIONS_ENV_FILE=./environments/dev/services/migrations.env
GTA_DATABASE_ENV_FILE=./environments/dev/services/database.env
GTA_WEB_ENV_FILE=./environments/dev/services/web.env
GTA_AUTOMATION_ENV_FILE=./environments/dev/services/worker-automation.env
GTA_RETENTION_ENV_FILE=./environments/dev/services/worker-retention.env

GTA_NGINX_BIND_IP=127.0.0.1
GTA_NGINX_PUBLIC_HOST=localhost
GTA_NGINX_HTTP_PORT=8080
GTA_NGINX_HTTPS_PORT=8443
GTA_NGINX_TLS_CERTIFICATE_FILE=./environments/dev/secrets/nginx.crt
GTA_NGINX_TLS_KEY_FILE=./environments/dev/secrets/nginx.key
GTA_NGINX_HTPASSWD_FILE=./environments/dev/secrets/nginx.htpasswd
GTA_NGINX_SECRET_GID=20001
