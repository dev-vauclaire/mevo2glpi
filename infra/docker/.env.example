# Nom stable utilisé pour les ressources Compose.
COMPOSE_FILE=/opt/glpi-ticketing-automation/infra/docker/docker-compose.prod.yaml
COMPOSE_PROJECT_NAME=glpi-ticketing-automation

# Les quatre sous-répertoires sont créés par prepare-host.sh.
GTA_DATA_ROOT=/srv/glpi-ticketing-automation/audio

# Seul Nginx publie des ports. Le loopback est le défaut prudent du POC.
GTA_NGINX_BIND_IP=127.0.0.1
GTA_NGINX_HTTPS_PORT=443
GTA_WEB_TMPFS_SIZE=128m

# Certificat, clé privée et htpasswd installés hors du dépôt.
GTA_NGINX_TLS_CERTIFICATE_FILE=/etc/glpi-ticketing-automation/nginx.fullchain.pem
GTA_NGINX_TLS_KEY_FILE=/etc/glpi-ticketing-automation/nginx.key
GTA_NGINX_HTPASSWD_FILE=/etc/glpi-ticketing-automation/nginx.htpasswd
GTA_NGINX_SECRET_GID=10002

# Fichiers runtime placés hors du dépôt sur le serveur.
GTA_WEB_ENV_FILE=/etc/glpi-ticketing-automation/web.env
GTA_WORKER_ENV_FILE=/etc/glpi-ticketing-automation/worker.env

# Aucun tag mobile : changer cette valeur à chaque version livrée.
GTA_IMAGE_TAG=0.1.0-poc
GTA_VCS_REF=replace-with-full-git-commit
GTA_NGINX_IMAGE=glpi-ticketing-nginx
GTA_WEB_IMAGE=glpi-ticketing-web
GTA_WORKER_IMAGE=glpi-ticketing-worker
