# Copiez ce fichier dans l'onglet Environment de Dokploy.
# Ne commitez jamais le fichier .env réel : il contient des secrets.

# -----------------------------------------------------------------------------
# Docker Compose et Dokploy
# -----------------------------------------------------------------------------
# Nom du projet Compose. Il préfixe les conteneurs créés par Dokploy.
COMPOSE_PROJECT_NAME=gta-prod

# Réseau externe créé par Dokploy. Le PostgreSQL séparé doit être joignable
# depuis ce réseau si son URL utilise un nom de service Docker.
DOKPLOY_NETWORK_NAME=dokploy-network

# Réseau privé partagé uniquement avec le PostgreSQL externe. Créez ce réseau
# avant le premier déploiement et attachez-y le service PostgreSQL.
DATABASE_NETWORK_NAME=gta-database-network

# Volume persistant partagé par le web et les deux workers. Utilisez un nom
# différent pour chaque environnement déployé sur le même hôte.
AUDIO_VOLUME_NAME=gta-prod-audio-data

# Bundle de confiance présent sur l'hôte Dokploy et monté en lecture seule dans
# les quatre conteneurs. Pour une CA interne, fournissez un bundle combinant la
# CA interne et les autorités publiques nécessaires. Ne désactivez pas TLS.
CA_BUNDLE_HOST_PATH=/etc/ssl/certs/ca-certificates.crt

# -----------------------------------------------------------------------------
# PostgreSQL externe — partagé par les quatre applications
# -----------------------------------------------------------------------------
# URL SQLAlchemy obligatoire. Le mot de passe doit être encodé dans l'URL.
# N'utilisez pas localhost : dans un conteneur, il désigne le conteneur lui-même.
# Sur le réseau Docker privé ci-dessus, PostgreSQL peut rester non exposé. Si la
# connexion quitte cet hôte, imposez `sslmode=verify-full` dans cette URL ; le
# bundle monté est disponible sous /etc/ssl/certs/gta-ca-bundle.pem.
DATABASE_URL=postgresql+psycopg://gta:CHANGE_ME@postgres:5432/glpi_ticketing_automation

# Délai de connexion utilisé par la migration et les workers.
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# -----------------------------------------------------------------------------
# Application de migration one-shot
# -----------------------------------------------------------------------------
# Temps maximal pendant lequel la migration attend PostgreSQL au démarrage.
DATABASE_READY_TIMEOUT_SECONDS=60

# Intervalle entre deux tentatives de connexion pendant cette attente.
DATABASE_READY_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Application web
# -----------------------------------------------------------------------------
# AUDIO_ROOT, WEB_HOST, WEB_PORT et WEB_TRUST_PROXY_HEADERS sont des invariants
# du Compose : /data/audios, 0.0.0.0, 8000 et false.
# Le web n'a pas d'authentification applicative : protégez son domaine dans
# Dokploy/Traefik et limitez-le au réseau interne.
# URL publique configurée dans l'onglet Domains de Dokploy. Le worker l'utilise
# pour écrire le lien de téléchargement de l'audio dans le ticket GLPI.
PUBLIC_BASE_URL=https://tickets.example.internal

# Taille maximale d'un upload en octets (25 MiB par défaut).
MAX_UPLOAD_BYTES=26214400

# Fréquence commune des heartbeats émis par les workers.
WORKER_HEARTBEAT_INTERVAL_SECONDS=10

# Seuils du tableau d'observabilité, tous exprimés en secondes.
DASHBOARD_WORKER_STALE_AFTER_SECONDS=45
DASHBOARD_PENDING_ALERT_AFTER_SECONDS=900
DASHBOARD_RETRY_OVERDUE_GRACE_SECONDS=60
DASHBOARD_RETENTION_DEADLINE_GRACE_SECONDS=120

# -----------------------------------------------------------------------------
# Worker d'automatisation
# -----------------------------------------------------------------------------
# Attente lorsqu'aucun job n'est disponible.
WORKER_IDLE_INTERVAL_SECONDS=1

# Un healthcheck devient invalide au-delà de ce délai sans heartbeat.
WORKER_HEALTHCHECK_STALE_AFTER_SECONDS=45

# Backoff appliqué quand GLPI ou Transcribe AI est temporairement indisponible.
WORKER_RETRY_INITIAL_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
WORKER_SYSTEM_PROBE_INTERVAL_SECONDS=60

# Délais de conservation utilisés lors de la création de la rétention.
COMPLETED_RETENTION_DAYS=90
FAILED_RETENTION_DAYS=30
BLOCKED_RETENTION_DAYS=90

# Fréquence de recontrôle d'un ticket GLPI encore ouvert, en heures.
RETENTION_CHECK_INTERVAL_HOURS=6

# -----------------------------------------------------------------------------
# Transcribe AI — utilisé uniquement par le worker d'automatisation
# -----------------------------------------------------------------------------
# URL de base de l'API, sans chemin createJob/result ni identifiants intégrés.
LEGACY_TRANSCRIPTION_BASE_URL=https://transcribe-ai.example.internal

# Secret fourni par Transcribe AI.
LEGACY_TRANSCRIPTION_API_KEY=CHANGE_ME

TRANSCRIPTION_HTTP_TIMEOUT_SECONDS=10
TRANSCRIPTION_POLL_INTERVAL_SECONDS=2
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=900

# -----------------------------------------------------------------------------
# GLPI — utilisé par les deux workers
# -----------------------------------------------------------------------------
# URL de base de GLPI, sans identifiants, query string ni fragment.
GLPI_BASE_URL=https://glpi.example.internal

# Utilisateur de service et client OAuth Password dédiés à l'application.
GLPI_USERNAME=CHANGE_ME
GLPI_PASSWORD=CHANGE_ME
GLPI_CLIENT_ID=CHANGE_ME
GLPI_CLIENT_SECRET=CHANGE_ME

GLPI_HTTP_TIMEOUT_SECONDS=10

# Valeurs fixes appliquées aux tickets créés par le worker d'automatisation.
GLPI_TICKET_TITLE=Demande issue d'un audio
GLPI_TICKET_TYPE=2
GLPI_TICKET_URGENCY=3
GLPI_TICKET_IMPACT=3

# -----------------------------------------------------------------------------
# Worker de rétention
# -----------------------------------------------------------------------------
# Fréquence de recherche d'une rétention éligible.
RETENTION_POLL_INTERVAL_SECONDS=60

# Backoff appliqué lorsque GLPI est temporairement indisponible.
RETENTION_RETRY_INITIAL_SECONDS=5
RETENTION_RETRY_MAX_SECONDS=300
RETENTION_SYSTEM_PROBE_INTERVAL_SECONDS=60
