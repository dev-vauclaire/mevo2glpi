# URL HTTPS publique de l'application web, visible par les utilisateurs GLPI.
PUBLIC_BASE_URL=https://audio-poc.example.test

# Ne jamais utiliser localhost ici : ces URL sont résolues depuis le conteneur.
LEGACY_TRANSCRIPTION_BASE_URL=https://transcribe-ai.example.test
LEGACY_TRANSCRIPTION_API_KEY='replace-with-test-server-secret'
TRANSCRIPTION_HTTP_TIMEOUT_SECONDS=10
TRANSCRIPTION_POLL_INTERVAL_SECONDS=2
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=900

# API GLPI V2.3.0 et client OAuth Password réservés au POC.
GLPI_BASE_URL=https://glpi.example.test
GLPI_USERNAME='replace-with-test-user'
GLPI_PASSWORD='replace-with-test-server-secret'
GLPI_CLIENT_ID='replace-with-test-client-id'
GLPI_CLIENT_SECRET='replace-with-test-server-secret'
GLPI_HTTP_TIMEOUT_SECONDS=10
GLPI_RETRY_INTERVAL_SECONDS=2

WORKER_SCAN_INTERVAL_SECONDS=1
GLPI_TICKET_TITLE=Demande issue d'un message audio
GLPI_TICKET_TYPE=2
GLPI_TICKET_URGENCY=3
GLPI_TICKET_IMPACT=3
