[Unit]
Description=GLPI Ticketing Automation MVP (production)
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/glpi-ticketing-automation
ExecStartPre=/usr/bin/docker compose --project-name gta-prod --env-file /etc/glpi-ticketing-automation/prod/compose.env --env-file /opt/glpi-ticketing-automation/infra/docker/environments/prod/versions.env --file /opt/glpi-ticketing-automation/infra/docker/compose.yaml --file /opt/glpi-ticketing-automation/infra/docker/environments/prod/compose.override.yaml config --quiet
ExecStart=/usr/bin/docker compose --project-name gta-prod --env-file /etc/glpi-ticketing-automation/prod/compose.env --env-file /opt/glpi-ticketing-automation/infra/docker/environments/prod/versions.env --file /opt/glpi-ticketing-automation/infra/docker/compose.yaml --file /opt/glpi-ticketing-automation/infra/docker/environments/prod/compose.override.yaml up --detach --remove-orphans --wait --wait-timeout 120
ExecStop=/usr/bin/docker compose --project-name gta-prod --env-file /etc/glpi-ticketing-automation/prod/compose.env --env-file /opt/glpi-ticketing-automation/infra/docker/environments/prod/versions.env --file /opt/glpi-ticketing-automation/infra/docker/compose.yaml --file /opt/glpi-ticketing-automation/infra/docker/environments/prod/compose.override.yaml stop --timeout 45
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
