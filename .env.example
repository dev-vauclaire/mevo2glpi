PUBLIC_BASE_URL=http://localhost:8000
AUDIO_PENDING_DIR=/data/audio-pending
AUDIO_PROCESSING_DIR=/data/audio-processing
AUDIO_COMPLETED_DIR=/data/audio-completed
AUDIO_FAILED_DIR=/data/audio-failed
WORKER_SCAN_INTERVAL_SECONDS=1
MAX_UPLOAD_BYTES=26214400

# Ancienne API de transcription. La clé doit rester dans le fichier .env local.
LEGACY_TRANSCRIPTION_BASE_URL=
LEGACY_TRANSCRIPTION_API_KEY=
TRANSCRIPTION_HTTP_TIMEOUT_SECONDS=10
TRANSCRIPTION_POLL_INTERVAL_SECONDS=2
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=900

# API GLPI V2.3.0. Les secrets doivent rester dans le fichier .env local.
GLPI_BASE_URL=
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_HTTP_TIMEOUT_SECONDS=10
GLPI_RETRY_INTERVAL_SECONDS=2

# Valeurs fixes appliquées à chaque ticket créé par le worker.
GLPI_TICKET_TITLE=Demande issue d'un message audio
# Type : 1=incident, 2=demande.
GLPI_TICKET_TYPE=2
# Niveaux GLPI : de 1=très faible à 5=très élevé.
GLPI_TICKET_URGENCY=3
GLPI_TICKET_IMPACT=3
