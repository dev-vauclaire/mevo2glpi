# Configuration locale depuis la racine du dépôt.
#
# Copier ce fichier vers `.env`, puis compléter uniquement les valeurs requises
# par le mode choisi. Ne jamais committer `.env`, une clé privée, un certificat
# interne ou un secret réel.

# -----------------------------------------------------------------------------
# Ressources partagées
# -----------------------------------------------------------------------------
# Identité non sensible affichée dans le dashboard. En local, ces valeurs
# explicites évitent de confondre une instance de développement avec staging ou
# production.
APP_ENVIRONMENT=development
APP_RELEASE=development
APP_COMMIT_SHA=unknown

# PostgreSQL est l'unique source de vérité. Cette URL correspond au Compose de
# développement versionné dans `infra/docker/development`. Les identifiants sont
# fictifs et ne doivent jamais être réutilisés hors de la machine locale.
DATABASE_URL=postgresql+psycopg://mevo2glpi_dev:mevo2glpi_dev_only@127.0.0.1:5432/mevo2glpi_dev
DATABASE_CONNECT_TIMEOUT_SECONDS=5
MEVO2GLPI_DEV_POSTGRES_PORT=5432

# Racine audio commune. Elle doit exister avant de lancer les applications.
AUDIO_ROOT=./infra/docker/runtime/audios

# Fichier local contenant une clé aléatoire de 32 octets encodée en Base64.
# Publisher et automation doivent lire exactement le même fichier.
ORIGINATING_PHONE_NUMBER_KEY_PATH=./infra/docker/runtime/secrets/originating-phone-number.key

# URL visible par les utilisateurs ; elle est inscrite dans les tickets GLPI.
PUBLIC_BASE_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Application de migration one-shot
# -----------------------------------------------------------------------------
DATABASE_READY_TIMEOUT_SECONDS=60
DATABASE_READY_INTERVAL_SECONDS=1

# -----------------------------------------------------------------------------
# Application web — consultation et action opérateur uniquement
# -----------------------------------------------------------------------------
WEB_HOST=127.0.0.1
WEB_PORT=8000
WEB_TRUST_PROXY_HEADERS=false

# Cadence et seuils de l'instantané d'observabilité des trois workers.
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
DASHBOARD_WORKER_STALE_AFTER_SECONDS=45
DASHBOARD_PENDING_ALERT_AFTER_SECONDS=900
DASHBOARD_RETRY_OVERDUE_GRACE_SECONDS=60
DASHBOARD_RETENTION_DEADLINE_GRACE_SECONDS=120

# -----------------------------------------------------------------------------
# Worker publisher — Exchange Online, Entra ID et Microsoft Graph
# -----------------------------------------------------------------------------
# Le développement utilise le simulateur local. `entra_certificate` et l'URL
# Microsoft officielle restent réservés aux environnements réels.
PUBLISHER_GRAPH_AUTH_MODE=synthetic
PUBLISHER_GRAPH_BASE_URL=http://127.0.0.1:18080/v1.0

# UUID de l'application Entra ID, du tenant et de la boîte dédiée.
PUBLISHER_ENTRA_TENANT_ID=
PUBLISHER_ENTRA_CLIENT_ID=
PUBLISHER_MAILBOX_ID=00000000-0000-4000-8000-000000000003

# Deux fichiers PEM distincts : une clé privée et son certificat public X.509.
# Les chemins sont ceux de la machine locale. La passphrase est facultative si
# la clé privée n'est pas chiffrée.
PUBLISHER_ENTRA_PRIVATE_KEY_PEM_PATH=
PUBLISHER_ENTRA_CERTIFICATE_PEM_PATH=
PUBLISHER_ENTRA_PRIVATE_KEY_PASSPHRASE=

# `INFO` en exploitation normale ; `DEBUG` seulement pour un diagnostic borné.
PUBLISHER_LOG_LEVEL=INFO
PUBLISHER_GRAPH_PAGE_SIZE=50
# Limite maximale stricte : 25 Mio. Une valeur supérieure est refusée.
PUBLISHER_MAX_ATTACHMENT_BYTES=26214400
PUBLISHER_HTTP_TIMEOUT_SECONDS=10
PUBLISHER_POLL_INTERVAL_SECONDS=30
PUBLISHER_HEARTBEAT_INTERVAL_SECONDS=10
PUBLISHER_RETRY_INITIAL_SECONDS=5
PUBLISHER_RETRY_MAX_SECONDS=300
PUBLISHER_SYSTEM_PROBE_INTERVAL_SECONDS=60

# -----------------------------------------------------------------------------
# Worker d'automatisation
# -----------------------------------------------------------------------------
# `DEBUG` ajoute des diagnostics réseau/TLS GLPI expurgés. Revenir à `INFO`
# après l'investigation.
WORKER_LOG_LEVEL=INFO
WORKER_IDLE_INTERVAL_SECONDS=1
WORKER_HEALTHCHECK_STALE_AFTER_SECONDS=45
WORKER_RETRY_INITIAL_SECONDS=5
WORKER_RETRY_MAX_SECONDS=300
# Nombre de reprogrammations après la tentative initiale.
WORKER_MAX_CONSECUTIVE_RETRIES=3
WORKER_SYSTEM_PROBE_INTERVAL_SECONDS=60

# Politique appliquée au moment où le job atteint un état terminal.
COMPLETED_RETENTION_DAYS=90
FAILED_RETENTION_DAYS=30
BLOCKED_RETENTION_DAYS=90
RETENTION_CHECK_INTERVAL_HOURS=6

# Choisir `legacy_polling` pour Transcribe AI ou `openai_compatible` pour un
# serveur synchrone exposant POST /v1/audio/transcriptions. Les secrets ne
# doivent apparaître ni dans Git ni dans les logs.
TRANSCRIPTION_PROVIDER=openai_compatible

# Provider historique asynchrone.
LEGACY_TRANSCRIPTION_BASE_URL=http://127.0.0.1:18081
LEGACY_TRANSCRIPTION_API_KEY=synthetic-development-legacy-key

# Provider synchrone compatible OpenAI. Ces valeurs sont obligatoires seulement
# lorsque TRANSCRIPTION_PROVIDER=openai_compatible.
OPENAI_COMPATIBLE_TRANSCRIPTION_BASE_URL=http://127.0.0.1:18082/v1
OPENAI_COMPATIBLE_TRANSCRIPTION_API_KEY=synthetic-development-openai-key
OPENAI_COMPATIBLE_TRANSCRIPTION_MODEL=synthetic-openai-model
OPENAI_COMPATIBLE_TRANSCRIPTION_LANGUAGE=fr

TRANSCRIPTION_HTTP_TIMEOUT_SECONDS=10
TRANSCRIPTION_POLL_INTERVAL_SECONDS=2
TRANSCRIPTION_JOB_TIMEOUT_SECONDS=900

# -----------------------------------------------------------------------------
# GLPI V2.3.0 — partagé par automation et retention. Le compte de service (ou
# le fuseau global hérité) doit utiliser Europe/Paris pour les dates métier.
# -----------------------------------------------------------------------------
GLPI_BASE_URL=http://127.0.0.1:18083
GLPI_USERNAME=glpi-test-development-user
GLPI_PASSWORD=synthetic-development-user-password-0001
GLPI_CLIENT_ID=glpi-test-development-client
GLPI_CLIENT_SECRET=synthetic-development-client-secret-0001
GLPI_HTTP_TIMEOUT_SECONDS=10

# Valeurs fixes des tickets créés par le worker d'automatisation.
GLPI_TICKET_TITLE=Demande issue d'un message audio
# Type : 1=incident, 2=demande. Niveaux : 1=très faible à 5=très élevé.
GLPI_TICKET_TYPE=1
# Identifiant local de la source GLPI `MEVO` (à relever dans cette instance).
GLPI_TICKET_REQUEST_SOURCE_ID=
GLPI_TICKET_URGENCY=3
GLPI_TICKET_IMPACT=3

# -----------------------------------------------------------------------------
# Worker de rétention
# -----------------------------------------------------------------------------
RETENTION_POLL_INTERVAL_SECONDS=60
RETENTION_RETRY_INITIAL_SECONDS=5
RETENTION_RETRY_MAX_SECONDS=300
RETENTION_SYSTEM_PROBE_INTERVAL_SECONDS=60

# Conservation des messages déplacés dans Exchange `Rejected` sans création de
# job. Le scan utilise RETENTION_CHECK_INTERVAL_HOURS et purge au plus 100
# ingestions par transaction.
REJECTED_INGESTION_RETENTION_DAYS=90

# -----------------------------------------------------------------------------
# Services de test Docker — valeurs exclusivement synthétiques
# -----------------------------------------------------------------------------
MEVO2GLPI_DEV_MICROSOFT_GRAPH_PORT=18080
MEVO2GLPI_DEV_TRANSCRIBE_AI_PORT=18081
MEVO2GLPI_DEV_OPENAI_TRANSCRIPTION_PORT=18082
MEVO2GLPI_DEV_GLPI_PORT=18083

MICROSOFT_GRAPH_SIMULATOR_ADMIN_TOKEN=synthetic-development-graph-admin-token
OPENAI_TRANSCRIPTION_SIMULATOR_MAX_UPLOAD_BYTES=26214400

GLPI_TEST_DB_NAME=glpi_development
GLPI_TEST_DB_USER=glpi_development
GLPI_TEST_DB_PASSWORD=synthetic-development-database-password
GLPI_TEST_DB_ROOT_PASSWORD=synthetic-development-root-password
GLPI_TEST_OAUTH_CLIENT_NAME=glpi-test-development-oauth
GLPI_TEST_REQUEST_SOURCE_NAME=MEVO
GLPI_TEST_TIMEZONE=Europe/Paris
